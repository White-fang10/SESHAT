rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check endpoint for connection verification
    match /test/connection {
      allow read, write: if true;
    }

    // Collaborative Notes collection (Google Keep live architecture)
    // Supports live editing across devices without requiring securetoken API
    match /notes/{noteId} {
      allow read, write: if true;
    }

    // User metadata and preferences
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
